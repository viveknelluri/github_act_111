# REQUIRED. Server-side only. In Vercel add it as type "Secret".
# Do NOT prefix it with VITE_ (that would expose it in the browser).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional but recommended while testing: if set, users must enter this code
# in the app before a check runs. Stops strangers from spending your API credit.
APP_ACCESS_CODE=

# Optional. Max calls per IP per hour, per endpoint (best effort). Default 12.
RATE_LIMIT_PER_HOUR=12
